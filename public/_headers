# Response headers for app.bumelerze.com (Cloudflare Pages reads this file
# from the root of dist-app). Security audit APP-07 / LIVE-06 (A2.3):
# - Content-Security-Policy: scripts only from this origin (plus Cloudflare
#   Turnstile), connections only to the services the app uses, no plugins,
#   no framing. Styles may be inline (react-native-web writes <style>).
#   Images may come from any https host (images cannot run code).
# - The map worker gets its own policy: it evaluates the right-to-left text
#   plugin (mapbox-gl-rtl-text.js) for Kurdish and Arabic labels, which needs
#   'unsafe-eval' inside the worker only, never on the page.
# - /turnstile (the CAPTCHA page the phone apps open) allows its one inline
#   script by hash; src/features/captcha/__tests__ keeps hash and file in step.
# - HSTS for a year, this host and anything under it. Not preloaded.
# - Permissions-Policy: location, camera and motion sensors for this origin
#   only; microphone, payment and USB for nobody.
# - A year's caching for the content-hashed files under /_expo/static/ and
#   /assets/ (A2.3 / B2.5): a new build gives every changed file a new name.
#   Safe because a missing file there answers 404 (scripts/build-app-web.sh
#   puts a not-found page in those folders), and Pages sends 404s no-store.
#   Never for /* : index.html and push-sw.js must be asked for every time.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(self), camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://bcgyxepgruwardhozvfq.supabase.co wss://bcgyxepgruwardhozvfq.supabase.co https://earthquake.usgs.gov https://www.seismicportal.eu https://geofon.gfz.de https://tiles.openfreemap.org https://api.maptiler.com https://s3.amazonaws.com https://peshawa-lh.github.io https://service.earthscope.org wss://rtserve.earthscope.org https://eida.koeri.boun.edu.tr https://data.raspberryshake.org https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/maplibre-gl-worker.mjs
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'self' https://bcgyxepgruwardhozvfq.supabase.co https://tiles.openfreemap.org https://api.maptiler.com https://s3.amazonaws.com https://peshawa-lh.github.io; img-src 'self' data: blob: https:; worker-src 'self' blob:

/turnstile
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'sha256-/YfcRjf4t45pi0h+x5IeHwbLx/rCMzPDIWkUP8k97bU=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/turnstile.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'sha256-/YfcRjf4t45pi0h+x5IeHwbLx/rCMzPDIWkUP8k97bU=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
