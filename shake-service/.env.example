# bumelerze-shake-service — worker environment template.
#
# Copy this file to `.env` (same directory, already git-ignored by the repo
# root's own `.env`/`.env.*` patterns — nothing extra to add here) and paste
# in real values, OR export them directly in whatever process manager runs
# `scripts/run_worker.py --daemon` server-side. Read only by
# `shake_service/worker/uploader.py`'s `build_uploader` and its `*_from_env`
# helpers — no other module in this package touches the network.
#
# Unlike the app's own `.env.example` (repo root, EXPO_PUBLIC_-prefixed,
# anon key, safe to ship inside a built app bundle), SUPABASE_SERVICE_ROLE_KEY
# below is a SERVER-SIDE secret: it bypasses Row Level Security entirely.
# Never commit a real value here, never put it in an EXPO_PUBLIC_ variable,
# never let the app read it.
#
# If SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are unset, the worker degrades
# safely rather than crashing: `build_uploader` logs a line and returns the
# pre-existing LocalOnlyUploader (products stay on disk under `products/`/
# `bumelerze-atlas/`, nothing reaches Supabase) — this is the worker's
# normal, expected mode until the orchestrator wires these in at deploy time.
# The three BUMELERZE_ATLAS_*/BUMELERZE_PUBLISH_RASTER variables below all
# have safe defaults and are never required for that fallback to trigger.

# Project Settings -> API -> Project URL (same value as the app's
# EXPO_PUBLIC_SUPABASE_URL — one project, two different keys).
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Project API keys -> service_role (secret).
# This key has BYPASSRLS — required because shakemap_products, events, and
# event_source_records all define zero client-writable RLS policies on
# purpose (supabase/README.md's "service_role bypass is implicit, not
# policy-based" convention). Never the anon key here. Supabase holds only
# the small, queryable INDEX row per product (event reference, version,
# engine provenance, review status, bounding box, artifact URL) — never the
# artifact bytes themselves (owner architecture decision).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where AtlasRepoPublisher stages the local copy of the Bumelerze Atlas data
# repository tree (the artifact FILES: contours/metadata JSON, and the
# raster grid when BUMELERZE_PUBLISH_RASTER is on) — a plain directory,
# never committed to this repo. Optional: defaults to `atlas-publish/` next
# to this package. Publishing that directory to the real, separately-hosted
# Atlas repository/CDN is an operational step the orchestrator owns, not
# something this worker does itself.
# BUMELERZE_ATLAS_PUBLISH_ROOT=/path/to/atlas-publish

# The Bumelerze Atlas data repository's real public base URL, once it has
# one (e.g. a GitHub Pages URL) — prefixed onto every published artifact's
# path before it's written into shakemap_products.storage_path. Optional:
# defaults to empty, which stores repo-relative paths instead (honest about
# "not published externally yet" rather than fabricating a URL that
# doesn't resolve) — backfill/recompute once the real URL exists (see
# shake-service/OPERATIONS.md §8c).
# BUMELERZE_ATLAS_BASE_URL=https://atlas.bumelerze.com

# Vector-first (owner architecture decision): the raster grid (grid.json,
# ~7 MB/event vs. contours' ~100-500 KB) is NOT published by default — no
# file written, no index row created for it. Set to 1/true/yes/on to opt
# in for events where a grid genuinely is needed; leave unset otherwise.
# BUMELERZE_PUBLISH_RASTER=false
