.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# run_halabja.py's downloaded USGS Atlas products (detail.json, grid.xml,
# stationlist.json — grid.xml alone is ~26 MB) — re-fetched on demand, never
# committed. Only validation/halabja/'s small derived outputs (results.json,
# REPORT.md, PNGs) are committed.
.cache/

# scripts/run_worker.py runtime artifacts: local worker state + exported
# shakemap products (default paths — see run_worker.py --state-path/
# --products-root). Neither is a checked-in artifact; both are regenerated
# by the worker itself. Anchored (leading "/") so this does NOT also catch
# bumelerze-atlas/worker_state.json below, which IS committed.
/worker_state.json
/products/

# bumelerze-atlas/ (scripts/seed_atlas.py, D21): cont_mi.json + info.json +
# compatibility.json + worker_state.json + SEED_SUMMARY.json ARE committed
# (small, the seed data src/features/shakemap/atlas/'s generator reads) —
# but grid.json (the compact raster, ~7 MB PER EVENT, not currently
# consumed by anything — export.py's own docstring: "for a future raster
# overlay renderer") is regenerable via `seed_atlas.py` and excluded here,
# same "heavy USGS-scale artifact, never committed" policy as `.cache/`
# above.
bumelerze-atlas/**/grid.json

# atlas-publish/ (default BUMELERZE_ATLAS_PUBLISH_ROOT, worker/uploader.py's
# AtlasRepoPublisher): the LOCAL STAGING copy of the separate, externally-
# published Bumelerze Atlas data repository — never committed here. The
# orchestrator syncs this tree to the real public repo/CDN (OPERATIONS.md
# §8d); this repo only ever produces it.
/atlas-publish/
